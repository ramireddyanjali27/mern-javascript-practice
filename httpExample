const ht=require("http");
const hte=ht.createServer((req,res)=>{
    if(req.url==='/'){
        res.end("Home Page");
    }else if(req.url==='/about'){
        res.end("About Page");

    }else if(req.url==='/service'){
        res.end("service page");
    }else{
        res.end("Page not found..");
    }
});
hte.listen(3005,()=>{
    console.log("Server started at 3000 port number");
});

